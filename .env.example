# ==========================================
# CONFIGURAÇÕES DO BOT DE ROMPIMENTO BYBIT
# ==========================================

# Símbolo padrão inicial e lista de todos os ativos monitorados
SYMBOL=BTCUSDT
SYMBOLS=BTCUSDT,ETHUSDT,HBARUSDT,LINKUSDT,SUIUSDT,AAVEUSDT,ONDOUSDT,DOGEUSDT,ENAUSDT

# Categoria na Bybit: 'linear' (Futuros Perpétuos USDT) ou 'spot' (À vista)
BYBIT_CATEGORY=linear

# Timeframes monitorados (sem 1m: 5m, 10m, 30m, 60m)
TIMEFRAMES=5,10,30,60

# Estratégia padrão: 'ema20_volume' (Rompimento MME 20 + Volume) ou 'triple_ema'
STRATEGY=ema20_volume

# Intervalo entre checagens em segundos (recomendado: 15)
CHECK_INTERVAL_SECONDS=15

# Confirmar sinal apenas no fechamento da vela (True = recomendado, evita repainting)
WAIT_CANDLE_CLOSE=True

# ==========================================
# NOTIFICAÇÕES WHATSAPP
# Opções: 'baileys' (QR Code no Painel Web), 'callmebot', 'console'
# ==========================================
WHATSAPP_PROVIDER=baileys

# Número de destino dos alertas (DDD + Número, ex: 5581999999999)
DESTINATION_PHONE=5581991798590

# --- CALLMEBOT (Opção Alternativa de Backup) ---
CALLMEBOT_PHONE=+5581991798590
CALLMEBOT_API_KEY=sua_api_key_aqui

# --- EVOLUTION API / Z-API / WEBHOOK (Opcionais) ---
EVOLUTION_API_URL=http://localhost:8080/message/sendText/sua_instancia
EVOLUTION_API_KEY=seu_token_aqui
